# GLOBAL EDU Environment Configuration
# Copy this file to .env for custom configuration

# Flask secret key for sessions and CSRF protection
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Server port (default: 5000)
PORT=5000

# Admin account setup (Optional - if left blank, a secure password is generated on startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@globaledu.local

# Database path (default: instance/global_edu.db)
DATABASE_PATH=instance/global_edu.db
